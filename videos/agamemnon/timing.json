[
 {
  "line": 0,
  "text": "Before Odysseus could find his way home,",
  "start": 0.4,
  "end": 2.628
 },
 {
  "line": 0,
  "text": "one king had to fall.",
  "start": 2.748,
  "end": 3.966
 },
 {
  "line": 0,
  "text": "This is Agamemnon.",
  "start": 4.346,
  "end": 5.507
 },
 {
  "line": 1,
  "text": "King of Mycenae,",
  "start": 6.037,
  "end": 7.142
 },
 {
  "line": 1,
  "text": "the richest city in Greece,",
  "start": 7.262,
  "end": 8.683
 },
 {
  "line": 1,
  "text": "and brother of Menelaus.",
  "start": 8.803,
  "end": 10.302
 },
 {
  "line": 2,
  "text": "When Paris of Troy took Helen,",
  "start": 10.832,
  "end": 12.471
 },
 {
  "line": 2,
  "text": "Menelaus's wife,",
  "start": 12.591,
  "end": 13.749
 },
 {
  "line": 2,
  "text": "Agamemnon gathered more than a thousand ships,",
  "start": 13.869,
  "end": 16.238
 },
 {
  "line": 2,
  "text": "and led the kings of Greece to war.",
  "start": 16.358,
  "end": 18.11
 },
 {
  "line": 3,
  "text": "But at Aulis,",
  "start": 18.64,
  "end": 19.53
 },
 {
  "line": 3,
  "text": "the winds died.",
  "start": 19.65,
  "end": 20.65
 },
 {
  "line": 3,
  "text": "To bring them back,",
  "start": 21.03,
  "end": 22.041
 },
 {
  "line": 3,
  "text": "he sacrificed his own daughter,",
  "start": 22.161,
  "end": 23.779
 },
 {
  "line": 3,
  "text": "Iphigenia.",
  "start": 23.899,
  "end": 24.812
 },
 {
  "line": 4,
  "text": "For ten years he besieged Troy.",
  "start": 25.342,
  "end": 27.176
 },
 {
  "line": 4,
  "text": "His pride almost lost the war,",
  "start": 27.556,
  "end": 29.302
 },
 {
  "line": 4,
  "text": "when he took Achilles' prize,",
  "start": 29.422,
  "end": 30.931
 },
 {
  "line": 4,
  "text": "and the greatest warrior refused to fight.",
  "start": 31.051,
  "end": 33.07
 },
 {
  "line": 5,
  "text": "At last,",
  "start": 33.6,
  "end": 34.26
 },
 {
  "line": 5,
  "text": "Troy fell,",
  "start": 34.38,
  "end": 35.086
 },
 {
  "line": 5,
  "text": "and Agamemnon sailed home a conqueror.",
  "start": 35.206,
  "end": 37.18
 },
 {
  "line": 6,
  "text": "But his wife,",
  "start": 37.71,
  "end": 38.5
 },
 {
  "line": 6,
  "text": "Clytemnestra,",
  "start": 38.62,
  "end": 39.518
 },
 {
  "line": 6,
  "text": "had never forgiven him.",
  "start": 39.638,
  "end": 40.909
 },
 {
  "line": 6,
  "text": "With her lover Aegisthus,",
  "start": 41.289,
  "end": 42.7
 },
 {
  "line": 6,
  "text": "she killed him on the day he came home.",
  "start": 42.82,
  "end": 44.828
 },
 {
  "line": 7,
  "text": "In The Odyssey,",
  "start": 45.358,
  "end": 46.246
 },
 {
  "line": 7,
  "text": "his ghost warns Odysseus:",
  "start": 46.366,
  "end": 48.07
 },
 {
  "line": 7,
  "text": "when you reach home,",
  "start": 48.45,
  "end": 49.459
 },
 {
  "line": 7,
  "text": "trust no one.",
  "start": 49.579,
  "end": 50.51
 },
 {
  "line": 8,
  "text": "In Christopher Nolan's film,",
  "start": 51.04,
  "end": 52.628
 },
 {
  "line": 8,
  "text": "Benny Safdie plays him:",
  "start": 52.748,
  "end": 54.028
 },
 {
  "line": 8,
  "text": "the king whose homecoming is the dark mirror of Odysseus's own.",
  "start": 54.408,
  "end": 58.207
 }
]