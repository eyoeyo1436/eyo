 {"text": "Meram'da huzurlu bir ev,", "start": 6.66, "end": 7.90},
 {"text": "Selçuklu'da değerli bir daire.", "start": 7.97, "end": 9.75},
 {"text": "Her şey tek bir telefonla başlar.", "start": 9.85, "end": 11.76},
 {"text": "Tuğba Korkmaz önce seni dinler:", "start": 11.95, "end": 13.79},
